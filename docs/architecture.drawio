        <mxCell id="blank-to-entry" source="blank-payload" target="w28IgjJjyw4SMm-o6-rj-162" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=9;labelBackgroundColor=#ffffff;strokeColor=#A680B8;dashed=1;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" value="">
          <mxGeometry as="geometry" relative="1">
