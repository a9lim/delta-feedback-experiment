# Data + figures are regenerated artifacts; keep them out of git.
data/
figures/

# References: refs.yaml is committed; fetched copies are regenerable.
references/*.md
references/*.pdf
references/*.html

# Run logs and checkpoints stay local.
logs/
runs/
tmp/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.env
.DS_Store
.idea/
.vscode/
.claude/
