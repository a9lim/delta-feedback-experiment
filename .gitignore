# Data + figures are regenerated artifacts; keep them out of git.
data/**
!data/.gitkeep
!data/summary/
!data/summary/**
figures/**
!figures/README.md
!figures/architectures/
!figures/architectures/**

# References: refs.yaml is committed; fetched copies are regenerable.
references/*.md
references/*.pdf
references/*.html
references/delta-attention-residuals-code/

# Run logs and checkpoints stay local.
logs/**
!logs/.gitkeep
runs/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.env
.DS_Store
.idea/
.vscode/
.claude/
